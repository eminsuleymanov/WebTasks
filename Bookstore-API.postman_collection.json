{
  "info": {
    "_postman_id": "85b4cc02-8523-4e82-aec8-c34bff19e765",
    "name": "Bookstore REST API",
    "description": "Requests for every endpoint in the Bookstore API. Seed the database first. Seed IDs: author=1, book=1, review=1. Run DELETE requests last.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "authorId", "value": "1" },
    { "key": "bookId", "value": "1" },
    { "key": "reviewId", "value": "1" }
  ],
  "item": [
    { "name": "Health", "item": [
      { "name": "Check API health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }
    ]},
    { "name": "Authors", "item": [
      { "name": "List authors", "request": { "method": "GET", "url": "{{baseUrl}}/authors" } },
      { "name": "Create author", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Octavia Butler\",\n  \"email\": \"octavia@example.com\",\n  \"bio\": \"American science fiction author.\"\n}" }, "url": "{{baseUrl}}/authors" } },
      { "name": "Get author by ID", "request": { "method": "GET", "url": "{{baseUrl}}/authors/{{authorId}}" } },
      { "name": "Replace author (PUT)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ursula K. Le Guin\",\n  \"email\": \"ursula@example.com\",\n  \"bio\": \"American author known for speculative fiction.\"\n}" }, "url": "{{baseUrl}}/authors/{{authorId}}" } },
      { "name": "Update author (PATCH)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"bio\": \"Updated biography.\"\n}" }, "url": "{{baseUrl}}/authors/{{authorId}}" } },
      { "name": "List author's books", "request": { "method": "GET", "url": "{{baseUrl}}/authors/{{authorId}}/books" } },
      { "name": "Delete author (run last)", "request": { "method": "DELETE", "url": "{{baseUrl}}/authors/{{authorId}}" } }
    ]},
    { "name": "Books", "item": [
      { "name": "List books", "request": { "method": "GET", "url": "{{baseUrl}}/books" } },
      { "name": "Create book", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Kindred\",\n  \"isbn\": \"9780807083697\",\n  \"description\": \"A time-travel novel.\",\n  \"publishedAt\": \"1979-01-01\",\n  \"authorId\": {{authorId}}\n}" }, "url": "{{baseUrl}}/books" } },
      { "name": "Get book by ID", "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" } },
      { "name": "Replace book (PUT)", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"A Wizard of Earthsea\",\n  \"isbn\": \"9780547773742\",\n  \"description\": \"A young wizard discovers the cost of power.\",\n  \"publishedAt\": \"1968-01-01\",\n  \"authorId\": {{authorId}}\n}" }, "url": "{{baseUrl}}/books/{{bookId}}" } },
      { "name": "Update book (PATCH)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated book description.\"\n}" }, "url": "{{baseUrl}}/books/{{bookId}}" } },
      { "name": "List book reviews", "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}/reviews" } },
      { "name": "Delete book (run last)", "request": { "method": "DELETE", "url": "{{baseUrl}}/books/{{bookId}}" } }
    ]},
    { "name": "Reviews", "item": [
      { "name": "List reviews", "request": { "method": "GET", "url": "{{baseUrl}}/reviews" } },
      { "name": "Create review for book", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reviewer\": \"Alex Reader\",\n  \"rating\": 4,\n  \"body\": \"Thoughtful and memorable.\"\n}" }, "url": "{{baseUrl}}/books/{{bookId}}/reviews" } },
      { "name": "Get review by ID", "request": { "method": "GET", "url": "{{baseUrl}}/reviews/{{reviewId}}" } },
      { "name": "Update review (PATCH)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"body\": \"Updated review text.\"\n}" }, "url": "{{baseUrl}}/reviews/{{reviewId}}" } },
      { "name": "Delete review (run last)", "request": { "method": "DELETE", "url": "{{baseUrl}}/reviews/{{reviewId}}" } }
    ]}
  ]
}
