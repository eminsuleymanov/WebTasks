{
  "name": "WebTask3",
  "version": "1.0.0",
  "description": "A REST API for managing authors, books, and reviews",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:generate": "prisma generate --schema schema.prisma",
    "db:migrate": "prisma migrate dev --schema schema.prisma",
    "db:seed": "node seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  }
}
